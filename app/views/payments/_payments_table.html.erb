<table class="table table-striped table-hover">
  <thead class="table-dark">
    <tr>
      <th>S/N</th>
      <th>Date</th>
      <th>Amount</th>
      <th>Status</th>
      <th>Stripe ID</th>
      <th>Print</th>
      <th>Mail Receipt</th>
    </tr>
  </thead>
  <tbody>
    <% @payments.each_with_index do |payment, index| %>
      <tr>
        <th scope="row"><%=index + 1 %></th>
        <td><%= payment.created_at.strftime('%Y-%m-%d')%></td>
        <td><%= payment.formatted_amount %></td>
        <td><%=payment.status %></td>
        <td><%= truncate(payment.stripe_payment_id, length: 10) %></td>
        <td><%= link_to 'Download Receipt', receipt_payment_path(payment), class: 'btn btn-info', target: '_blank' %></td>
        <td><%= button_to 'Send Receipt', send_receipt_payment_path(payment), method: :post, class: 'btn btn-info' %></td>
      </tr>
    <% end %>
  </tbody>
</table>
