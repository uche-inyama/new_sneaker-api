<div class="container">
  <h1>Payment Dashboard</h1>
  <div class="d-flex justify-content-end mb-4">
    <%= link_to 'Export to CSV', payments_path(request.query_parameters.merge(format: :csv)), class: 'btn btn-success me-2' %>
    <%= link_to 'View Chart', payments_chart_view_path, class: 'btn btn-primary' %>
  </div>

  <%= render partial: "filterForm" %>

  <% if @payments.any? %>
    <div class="table-responsive">
      <%= render "payments_table", payments: @payments %>
    </div>
    <%= paginate @payments %>
  <% else %>
    <p>No payments found. </p>
  <% end %>
</div>